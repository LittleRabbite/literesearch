# ===== LLM（DeepSeek，OpenAI 兼容）=====
DEEPSEEK_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 1 = 无需 API key 的演示模式（假 LLM，全流程可跑通）；0 = 真实调用
MOCK_LLM=1

# ===== 嵌入去重 =====
# 默认轻量模型 CPU 秒级；追求质量且有 GPU 可换 BAAI/bge-m3（CPU 每轮数分钟）
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HuggingFace 直连慢时启用镜像
HF_ENDPOINT=https://hf-mirror.com
DEDUP_THRESHOLD=0.93

# ===== 检索 =====
S2_API_KEY=
MIN_PAPERS=8
MAX_RETRY=3

# ===== Zotero（可选，配置后可一键推送）=====
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# ===== Langfuse（可选，评估用）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
